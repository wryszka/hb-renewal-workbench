{
 "datasets": [
  {
   "name": "ds_bench",
   "displayName": "By carrier",
   "queryLines": [
    "SELECT carrier, round(avg(book_trend_median),4) book_trend, round(avg(avg_carrier_action),4) carrier_action, ",
    "round(avg(avg_negotiated_action),4) negotiated_action, round(avg(avg_negotiation_delta),4) delta, ",
    "round(sum(total_value_negotiated),0) value_negotiated, sum(renewals_negotiated) renewals, ",
    "CASE WHEN avg(book_trend_median)>=0.075 THEN 'Padder (rich)' WHEN avg(book_trend_median)<=0.06 THEN 'Fair' ELSE 'Mid' END flag ",
    "FROM `lr_dev_aws_us_catalog`.`hb_renewal`.`6_book_trend_benchmark` GROUP BY carrier ORDER BY carrier_action DESC "
   ]
  },
  {
   "name": "ds_action",
   "displayName": "Ask vs negotiated",
   "queryLines": [
    "SELECT carrier, 'Carrier ask' series, round(avg(avg_carrier_action),4) action FROM `lr_dev_aws_us_catalog`.`hb_renewal`.`6_book_trend_benchmark` GROUP BY carrier ",
    "UNION ALL ",
    "SELECT carrier, 'Our negotiated' series, round(avg(avg_negotiated_action),4) action FROM `lr_dev_aws_us_catalog`.`hb_renewal`.`6_book_trend_benchmark` GROUP BY carrier "
   ]
  },
  {
   "name": "ds_band",
   "displayName": "By group band",
   "queryLines": [
    "SELECT group_band, round(avg(avg_carrier_action),4) carrier_action, round(avg(avg_negotiated_action),4) negotiated_action, ",
    "sum(renewals_negotiated) renewals FROM `lr_dev_aws_us_catalog`.`hb_renewal`.`6_book_trend_benchmark` GROUP BY group_band ORDER BY group_band "
   ]
  },
  {
   "name": "ds_claims",
   "displayName": "Claims experience",
   "queryLines": [
    "SELECT to_date(concat('01-',month),'dd-MMM-yyyy') month_date, round(sum(total_incurred),0) total_incurred, round(avg(pmpm),2) pmpm ",
    "FROM `lr_dev_aws_us_catalog`.`hb_renewal`.`mv_claims_experience` GROUP BY month ORDER BY month_date "
   ]
  }
 ],
